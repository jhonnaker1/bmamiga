[submodule "third_party/circle-stdlib"]
	path = third_party/circle-stdlib
	url = https://github.com/smuehlst/circle-stdlib
	ignore = dirty
[submodule "third_party/amiberry"]
	path = third_party/amiberry
	url = https://github.com/BlitterStudio/amiberry.git
	ignore = dirty
	shallow = true
[submodule "third_party/zlib"]
	path = third_party/zlib
	url = https://github.com/madler/zlib.git
